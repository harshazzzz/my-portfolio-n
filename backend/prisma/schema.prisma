generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  USER
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  password String
  name String?
  role Role @default(USER)
  tokenVersion Int @default(0)
  resetTokenHash String? @unique
  resetExpiresAt DateTime?
  resetRequestedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BlogStatus {
 DRAFT
 PUBLISHED
}
model Blog {
 id String @id @default(uuid()) @db.Uuid
 title String
 slug String @unique
 excerpt String
 content String
 coverImage String @default("")
 category String
 tags String[]
 status BlogStatus @default(DRAFT)
 publishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status, publishedAt])
}

enum ProjectStatus {
 DRAFT
 PUBLISHED
}
model Project {
 id String @id @default(uuid()) @db.Uuid
 title String
 slug String @unique
 category String
 shortDescription String
 description String
 coverImage String @default("")
 images String[]
 technologies String[]
 githubUrl String @default("")
 liveUrl String @default("")
 featured Boolean @default(false)
 status ProjectStatus @default(DRAFT)
 role String @default("")
 features String[]
 benefits String[]
 accent String @default("cyan")
 preview String @default("generic")
 sortOrder Int @default(100)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status, featured, sortOrder])
}

enum MessageStatus {
 UNREAD
 READ
}
model Message {
 id String @id @default(uuid()) @db.Uuid
 name String
 email String
 subject String
 message String
 status MessageStatus @default(UNREAD)
 createdAt DateTime @default(now())
 @@index([status, createdAt])
}
