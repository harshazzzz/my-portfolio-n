# PostgreSQL example: postgresql://USER:PASSWORD@localhost:5432/harsha_portfolio?schema=public
DATABASE_URL=
# Optional Neon direct (non-pooler) URL for Prisma migrations.
DIRECT_URL=
# Generate a random secret of at least 32 characters; never commit backend/.env.
JWT_SECRET=
JWT_EXPIRES_IN=1h
PORT=3001
ADMIN_SEED_EMAIL=admin@harsha.dev
ADMIN_SEED_PASSWORD=

# Password recovery: server-only Resend key and verified sender address.
RESEND_API_KEY=
RESET_EMAIL_FROM=
# Exact trusted frontend origin (HTTPS in production).
FRONTEND_URL=
# Optional additional exact browser origins, comma-separated. HTTPS in production.
CORS_ORIGINS=

# Cloudinary: server-only credentials for future signed uploads.
# Current CMS accepts HTTPS image URLs from the Cloudinary Media Library.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
